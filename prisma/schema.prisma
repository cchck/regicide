// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  displayName  String
  chips        Int      @default(200)
  // The stake currently on an AI table (deducted at match/start, null when settled).
  // Its purpose is the settlement clamp: E-card is zero-sum with both sides seated at
  // the same stack, so no honest match can ever pay out more than 2× this figure —
  // which turns "client reports any number it likes" into a bounded, closable claim.
  activeStake  Int?
  // When that stake was posted. Two uses: bounding how many tendency rows one match may
  // report, and (later) refusing to pay seals for a "match" that ended milliseconds after
  // it began.
  stakeAt      DateTime?
  // The buy-in on a live PvP table (set at seating, cleared at settlement). Primary
  // recovery is resume-from-DB (see PvpRoom); pvpStake is the safety net — on boot, any
  // stake whose room could NOT be restored is refunded, so no buy-in ever vanishes.
  pvpStake     Int?
  // 金印 — the cosmetic currency, deliberately separate from chips. Chips are the stake
  // and can be lost at the table; seals are earned by achievement and buy only
  // appearances. Nothing bought with seals can ever be gambled away, which is the whole
  // reason for the split: what a player owns stays owned.
  seals        Int      @default(0)
  /** Equipped cosmetics, { slot: itemId }. Normalised on read — see lib/shop.ts. */
  loadout      Json?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  cardPlayStats  CardPlayStat[]
  cardPlayEvents CardPlayEvent[]
  ownedItems     OwnedItem[]
}

enum Role {
  EMPEROR
  SLAVE
}

enum CardKind {
  EMPEROR
  CITIZEN
  SLAVE
}

// Raw per-round play log — source of truth. One row per round the user played.
// Keeps full context (round, stakes, outcome) so future analysis can slice any way.
// Where a row came from, and therefore how much it can be trusted.
//
// PVP rows are written by the ws server out of its own authoritative state — the client
// never touches them, so they cannot be forged. AI rows are POSTed by the browser
// (/api/stats/play) because the AI match runs there; they're bounded (an open buy-in is
// required and there's a per-match ceiling) but they are still a claim, not a fact.
//
// Keeping them apart is what lets a competitive board be built on the trustworthy half.
enum PlaySource {
  AI
  PVP
}

model CardPlayEvent {
  id            String     @id @default(cuid())
  userId        String
  user          User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  role          Role // which side the user was on
  card          CardKind // what they played
  round         Int // 1..5 within the set — the key tell in E-Card
  betMultiplier Int // pot multiplier when the round resolved
  won           Boolean
  folded        Boolean // round ended in a fold (no showdown — play stays private)
  foldedSelf    Boolean // the user was the one who folded
  source        PlaySource @default(AI)
  createdAt     DateTime   @default(now())

  @@index([userId, role])
  // The per-match ceiling counts a user's recent rows; without this it's a scan.
  @@index([userId, createdAt])
}

// Aggregate cache of PUBLIC tendencies — only showdown (non-folded) plays are counted,
// because that's all a future PvP opponent is entitled to see.
// Probability = count / sum(counts for that user+role+round).
model CardPlayStat {
  id       String   @id @default(cuid())
  userId   String
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role     Role
  cardKind CardKind
  round    Int // 1..5
  count    Int      @default(0)

  @@unique([userId, role, cardKind, round])
}

// A live PvP room, mirrored out of the ws server's in-memory Map so a process restart
// (deploy / crash / machine migration) doesn't lose matches. Written on every state
// change, read back on boot to rebuild the rooms and re-arm timers from `deadline`.
// Deleted when the room is torn down. `version` guards against a GameState shape change
// between deploys: a row whose version differs from the running server is unrestorable,
// and only THAT room falls back to refund — never the others.
model PvpRoom {
  code      String   @id
  version   Int
  data      Json // { tierKey, buyIn, host, guest, state, deadline, endInfo, insights, finished }
  updatedAt DateTime @updatedAt
}

// A message waiting for a player who wasn't connected when something happened to their
// match — chiefly "your match was voided by a restart and the buy-in refunded". Delivered
// on their next ws connect, then deleted. Without this the player just finds their room
// gone and reads it as a bug.
// A cosmetic the player owns. Free defaults are never written here — ownership of those
// is implicit, so a fresh account needs no seeding.
model OwnedItem {
  id       String   @id @default(cuid())
  userId   String
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  itemId   String // matches an id in lib/shop.ts
  boughtAt DateTime @default(now())
  /** What was paid, kept for the record even if the price later changes. */
  paid     Int      @default(0)

  @@unique([userId, itemId])
}

model PvpNotice {
  id        String   @id @default(cuid())
  userId    String   @unique // one pending notice per player; a newer one supersedes
  kind      String // 'voided'
  refund    Int      @default(0)
  createdAt DateTime @default(now())
}
